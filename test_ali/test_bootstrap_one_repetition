# ============================================================
# 1. Correct resampler -- fixes the id-collision bug (3.1)
# ============================================================
resample_subjects <- function(data, ids) {
  idx_by_id <- split(seq_len(nrow(data)), data$id)
  drawn     <- idx_by_id[as.character(ids)]
  out       <- data[unlist(drawn, use.names = FALSE), ]
  out$id    <- rep(seq_along(drawn), lengths(drawn))
  out
}

# ============================================================
# 2. Fit the 22-model candidate set and pull out everything
#    worth recording for one dataset (original or bootstrap draw)
# ============================================================
fit_and_summarize <- function(data, n, n.visit = 100) {

  fit <- fit_models(data, n = n, n.visit = n.visit)
  ipw_names <- grep("ipw", names(fit), value = TRUE)     # the 22 reported candidates

  bic_vals <- sapply(fit[ipw_names], function(m) m[["BIC"]])
  aic_vals <- sapply(fit[ipw_names], function(m) m[["AIC"]])
  names(bic_vals) <- names(aic_vals) <- ipw_names

  best_bic_name <- names(which.min(bic_vals))
  best_aic_name <- names(which.min(aic_vals))

  extract_P0 <- function(model_name) {
    tmp <- fit[[model_name]][["Pr_Y_A0"]]
    if ("Pr_A0_ipw" %in% names(tmp)) {
      c(P0 = as.numeric(tmp["Pr_A0_ipw"]),
        P0_lower = as.numeric(tmp["lower"]),
        P0_upper = as.numeric(tmp["upper"]))
    } else {
      c(P0 = as.numeric(tmp), P0_lower = NA_real_, P0_upper = NA_real_)
    }
  }

  P_observed <- 1 - fit[["cox_ipw_null"]][["proba_observed"]]
  n_events   <- fit[["cox_ipw_null"]][["nevent"]]

  paf_from <- function(model_name) {
    p0 <- extract_P0(model_name)
    PAF       <- (P_observed - p0["P0"])       / P_observed
    PAF_lower <- (P_observed - p0["P0_upper"]) / P_observed   # P0 CI flips for PAF CI
    PAF_upper <- (P_observed - p0["P0_lower"]) / P_observed
    c(p0, PAF = unname(PAF), PAF_lower = unname(PAF_lower), PAF_upper = unname(PAF_upper))
  }

  bic_res <- paf_from(best_bic_name)
  aic_res <- paf_from(best_aic_name)

  extract_diagnostics <- function(model_name) {
    coefs <- fit[[model_name]][["coefficients"]]
    max_abs_coef <- if (!is.null(coefs) && nrow(coefs) > 0) max(abs(coefs[, "coef"])) else NA_real_
    max_se        <- if (!is.null(coefs) && nrow(coefs) > 0) max(coefs[, "se(coef)"]) else NA_real_
    c(max_abs_coef = max_abs_coef, max_se = max_se)
  }
  bic_diag <- extract_diagnostics(best_bic_name)
  aic_diag <- extract_diagnostics(best_aic_name)

  list(
    # ---- single-row summary (what you'll rbind across bootstrap reps) ----
    summary_row = data.frame(
      model_BIC       = best_bic_name,
      BIC_value       = min(bic_vals),
      P0_BIC          = bic_res["P0"],
      P0_lower_BIC    = bic_res["P0_lower"],
      P0_upper_BIC    = bic_res["P0_upper"],
      PAF_BIC         = bic_res["PAF"],
      PAF_lower_BIC   = bic_res["PAF_lower"],
      PAF_upper_BIC   = bic_res["PAF_upper"],
      max_abs_coef_BIC = bic_diag["max_abs_coef"],   # >~5-10 on a Cox log-HR scale is a red flag
      max_se_BIC       = bic_diag["max_se"],         # blown-up SE = quasi-separation signature
      flag_unstable_BIC = isTRUE(bic_diag["max_abs_coef"] > 5 | bic_diag["max_se"] > 1),

      model_AIC       = best_aic_name,
      AIC_value       = min(aic_vals),
      P0_AIC          = aic_res["P0"],
      PAF_AIC         = aic_res["PAF"],
      max_abs_coef_AIC = aic_diag["max_abs_coef"],
      max_se_AIC       = aic_diag["max_se"],

      P_observed      = P_observed,
      n_events        = n_events,
      same_model_selected = (best_bic_name == best_aic_name),
      row.names = NULL
    ),
    # ---- full detail, kept separately in case you want to inspect later ----
    bic_all = bic_vals,
    aic_all = aic_vals
  )
}

# ============================================================
# 2b. True PAF for this scenario (decreasing, HRA=4, lambda0=0.0005)
#     -- computed the same way as file 5's .get_true_proba_by_integration(),
#     used only as a reference to sanity-check the numbers below, NOT part
#     of the estimation pipeline itself.
# ============================================================
get_true_PAF_reference <- function(weight_hypo, HRA, lambda0, n.visit = 100, true_cutoff = 100) {
  x <- 0:true_cutoff
  weights <- if (weight_hypo == "decreasing") {
    y <- exp(-0.1 * x); y / sum(y)
  } else if (weight_hypo == "constant") {
    rep(1 / length(x), length(x))
  } else if (weight_hypo == "only_current") {
    c(1, rep(0, length(x) - 1))
  } else if (weight_hypo == "middle_peak") {
    y <- dnorm(seq(0.2 - 4*0.06, 0.2 + 4*0.06, length.out = true_cutoff + 1), mean = 0.2, sd = 0.06)
    y / sum(y)
  }
  true_risk <- function(scena_A) {
    Amat <- matrix(scena_A, nrow = 1, ncol = n.visit)
    wce_t <- numeric(n.visit)
    for (t in 1:n.visit) {
      s <- 0
      for (i in 0:min(true_cutoff, t-1)) s <- s + Amat[1, t - i] * weights[i+1]
      wce_t[t] <- s
    }
    lambda_t <- lambda0 * exp(wce_t * log(HRA))
    1 - exp(-sum(lambda_t))
  }
  P0_true <- true_risk(0)
  P_obs_lookup <- c(decreasing_4 = 0.088625, middle_peak_4 = 0.08166,
                     constant_4 = 0.078415, only_current_4 = 0.108851)  # from file 5, HR=4 rows
  key <- paste0(weight_hypo, "_", HRA)
  P_observed_true <- if (key %in% names(P_obs_lookup)) P_obs_lookup[[key]] else NA_real_
  list(P0_true = P0_true, P_observed_true = P_observed_true,
       PAF_true = (P_observed_true - P0_true) / P_observed_true)
}
true_ref <- get_true_PAF_reference("decreasing", HRA = 4, lambda0 = 0.0005)
cat("Reference true PAF for this scenario ≈", round(true_ref$PAF_true, 4),
    "(P0_true =", round(true_ref$P0_true, 4), ", P_observed_true =", round(true_ref$P_observed_true, 4), ")\n\n")

# ============================================================
# 3. Point estimate on the original n=1000 sample
# ============================================================
set.seed(1)
d <- sim_MSM_WCE(weight_hypo = "decreasing", n = n_sample, HRA = 4,
                  lambda0 = 0.0005, seed = 1)$dat.complet
cat("Event rate:", mean(tapply(d$event, d$id, max)), "\n")

t0 <- Sys.time()
point_res <- fit_and_summarize(d, n = n_sample, n.visit = 100)
point_res$summary_row$boot_id <- 0L
point_res$summary_row$type    <- "point_estimate"
point_res$summary_row$time_s  <- round(as.numeric(Sys.time() - t0, units = "secs"), 1)
cat("Point estimate done in", point_res$summary_row$time_s, "s | BIC model:",
    point_res$summary_row$model_BIC, "| PAF =", round(point_res$summary_row$PAF_BIC, 4), "\n")

# ============================================================
# 4. Ten bootstrap replicates -- re-selecting BIC/AIC inside each one
# ============================================================

subject_ids <- unique(d$id)
n_id <- length(subject_ids)

results_list  <- vector("list", B)
bic_full_list <- vector("list", B)   # full 22-model BIC vector per replicate

for (b in 1:B) {
  t1 <- Sys.time()
  sampled_id <- sample(subject_ids, size = n_id, replace = TRUE)
  boot_data  <- resample_subjects(d, sampled_id)

  res <- fit_and_summarize(boot_data, n = n_id, n.visit = 100)
  res$summary_row$boot_id <- b
  res$summary_row$type    <- "bootstrap"
  res$summary_row$time_s  <- round(as.numeric(Sys.time() - t1, units = "secs"), 1)

  results_list[[b]]  <- res$summary_row
  bic_full_list[[b]] <- res$bic_all

  cat(sprintf("[boot %2d/%2d] BIC model = %-30s PAF = %.4f | AIC model = %-30s PAF = %.4f | events = %d | %.1fs\n",
              b, B, res$summary_row$model_BIC, res$summary_row$PAF_BIC,
              res$summary_row$model_AIC, res$summary_row$PAF_AIC,
              res$summary_row$n_events, res$summary_row$time_s))

  # incremental save -- protects against losing everything if the run is
  # interrupted partway (each rep takes several minutes)
  interim <- rbind(point_res$summary_row, do.call(rbind, results_list[1:b]))
  saveRDS(list(all_results = interim, BIC_full_mat_so_far = do.call(rbind, bic_full_list[1:b])),
          file = "bootstrap_pilot_n10000_B10_results.rds")
  write.csv(interim, "bootstrap_pilot_n10000_B10_results.csv", row.names = FALSE)
}

# ============================================================
# 5. Assemble the results table
# ============================================================
boot_results <- do.call(rbind, results_list)
all_results  <- rbind(point_res$summary_row, boot_results)

# full BIC matrix (rows = bootstrap reps, cols = 22 candidate models)
# useful for deciding which models actually compete for BIC, to shrink
# the candidate set later
BIC_full_mat <- do.call(rbind, bic_full_list)
rownames(BIC_full_mat) <- paste0("boot_", 1:B)

# ============================================================
# 6. Summaries
# ============================================================
cat("\n--- summary across", B, "bootstrap reps ---\n")
cat("Reference true PAF      :", round(true_ref$PAF_true, 4), "\n")
cat("Point estimate PAF (BIC):", round(point_res$summary_row$PAF_BIC, 4), "\n")
cat("Bootstrap mean PAF (BIC):", round(mean(boot_results$PAF_BIC), 4), "\n")
cat("Bootstrap SD (SE)       :", round(sd(boot_results$PAF_BIC), 4), "\n")
cat("Bootstrap 95% percentile CI:", round(quantile(boot_results$PAF_BIC, c(.025, .975)), 4), "\n")
cat("  -> covers true PAF?", 
    (quantile(boot_results$PAF_BIC, .025) <= true_ref$PAF_true) & 
    (true_ref$PAF_true <= quantile(boot_results$PAF_BIC, .975)), "\n")
cat("Mean events per bootstrap replicate:", round(mean(boot_results$n_events), 1), "\n")
cat("BIC and AIC agreed on the same model in", sum(boot_results$same_model_selected), "/", B, "reps\n")
cat("Replicates flagged unstable (max|coef|>5 or max SE>1):",
    sum(boot_results$flag_unstable_BIC), "/", B, "\n")
cat("\nModel selected by BIC across bootstrap reps:\n")
print(table(boot_results$model_BIC))

# ============================================================
# 7. Save everything so you don't have to re-run to inspect later
# ============================================================
saveRDS(list(all_results = all_results, BIC_full_mat = BIC_full_mat),
        file = "bootstrap_pilot_n10000_B10_results.rds")
write.csv(all_results, "bootstrap_pilot_n10000_B10_results.csv", row.names = FALSE)

