make_wce_plot <- function(list_model_output,
                          model_name,
                          beta_true,
                          title = NULL,
                          y_limits = c(-0.1, 0.2),
                          show_legend = FALSE,
                          show_y = TRUE) {
  
  # list_model_output 应是一组模拟结果，每个元素对应一次模拟
  weights <- lapply(list_model_output, function(x) {
    model <- x[[model_name]]
    if (is.null(model) || is.null(model[["coef_weight_predict"]])) {
      stop("Missing coef_weight_predict for model: ", model_name)
    }
    as.numeric(model[["coef_weight_predict"]])
  })
  
  n_lag <- length(weights[[1]])
  if (!all(lengths(weights) == n_lag)) {
    stop("The number of lag coefficients differs between simulations.")
  }
  
  est_weight_mat <- do.call(cbind, weights)
  n_sim <- ncol(est_weight_mat)
  time_since_expo <- 0:(n_lag - 1)
  
  df_wce <- as.data.frame(est_weight_mat)
  names(df_wce) <- paste0("sim", seq_len(n_sim))
  df_wce$time_since_expo <- time_since_expo
  
  df_long <- df_wce %>%
    tidyr::pivot_longer(
      cols = starts_with("sim"),
      names_to = "simulation",
      values_to = "coef"
    ) %>%
    dplyr::mutate(group = "simulation")
  
  df_mean <- df_long %>%
    dplyr::group_by(time_since_expo) %>%
    dplyr::summarise(coef = mean(coef), .groups = "drop") %>%
    dplyr::mutate(group = "mean")
  
  df_true <- data.frame(
    time_since_expo = time_since_expo,
    coef = rep(beta_true / n_lag, n_lag),
    group = "true"
  )
  
  ggplot() +
    geom_line(
      data = df_long,
      aes(x = time_since_expo, y = coef,
          group = simulation, color = group),
      linewidth = 0.5,
      alpha = 0.6
    ) +
    geom_line(
      data = df_mean,
      aes(x = time_since_expo, y = coef, color = group),
      linewidth = 1.3
    ) +
    geom_line(
      data = df_true,
      aes(x = time_since_expo, y = coef, color = group),
      linewidth = 1.3
    ) +
    scale_color_manual(
      values = c(
        simulation = "grey70",
        mean = "blue4",
        true = "red4"
      ),
      labels = c(
        simulation = "Simulations",
        mean = "Mean estimate",
        true = "True effect"
      )
    ) +
    theme_minimal() +
    labs(
      title = if (is.null(title)) model_name else title,
      x = "Time since exposure",
      y = if (show_y) "Estimated coefficient" else NULL,
      color = "Legend"
    ) +
    theme(
      axis.text = element_text(size = 12),
      plot.title = element_text(hjust = 0.5),
      legend.position = if (show_legend) "right" else "none"
    ) +
    scale_y_continuous(limits = y_limits)
}

