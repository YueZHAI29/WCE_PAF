library(patchwork)
# Create a plot for each scenario separately
# Create plot for each scenario
plot_list <- lapply(unique(df_long$Scenario), function(scen) {
  df_sub <- df_long %>% dplyr::filter(!is.na(model_display)) %>% 
    dplyr::filter(Scenario == scen)
  # [REV-NULL] Null is shown numerically in grey and excluded from colour limits/quantiles.
  df_null <- df_sub[df_sub$model_names=="cox_ipw_null",,drop=FALSE]
  df_sub <- df_sub[df_sub$model_names!="cox_ipw_null",,drop=FALSE]
  
  p <- ggplot(df_sub, aes(x = 1, y = model_display, fill = RMSE)) +
    geom_tile(color = "white", width = 0.9) +
    # [REV-NULL] Fixed neutral layer has no fill mapping.
    geom_tile(data=df_null,aes(x=1,y=model_display),inherit.aes=FALSE,fill="#D9D9D9",color="white",width=0.9) +
    geom_text(data=df_null,aes(x=1,y=model_display,label=sprintf("%.3f",RMSE)),inherit.aes=FALSE,size=2.5) +
    scale_y_discrete(limits=rev(model_dictionary()$axis_label),drop=FALSE) +
    scale_fill_gradientn(
      colours = c("#00004d", "#4d4d99", "#9999b3", "#ddddf0", "white"),
      breaks = c( 0.05, 0.1, 0.15, 0.2),
      labels = scales::number_format(accuracy = 0.01),
      values = scales::rescale(c(min(df_sub$RMSE), quantile(df_sub$RMSE, 0.25),
                                 median(df_sub$RMSE), quantile(df_sub$RMSE, 0.75),
                                 max(df_sub$RMSE)))    ) +
    theme_minimal(base_size = 11) +
    labs(title = scen, x = NULL, y = NULL) +
    theme(
      axis.text.x = element_blank(),
      axis.ticks = element_blank(),
      plot.title = element_text(size = 11, hjust = 0.5),
      legend.position = "bottom",
      legend.key.height = unit(0.35, "cm"),
      legend.key.width = unit(0.7, "cm"),
      legend.text = element_text(size = 6),
      legend.title = element_text(size = 7),
      panel.grid = element_blank()
    )
  # 计算该场景的数据范围，用于自动生成刻度
  rmse_range <- range(df_sub$RMSE, na.rm = TRUE)
  p <- ggplot(df_sub, aes(x = 1, y = model_display, fill = RMSE)) +
    geom_tile(color = "white", width = 0.9) +
    # [REV-NULL] Fixed neutral layer has no fill mapping.
    geom_tile(data=df_null,aes(x=1,y=model_display),inherit.aes=FALSE,fill="#D9D9D9",color="white",width=0.9) +
    geom_text(data=df_null,aes(x=1,y=model_display,label=sprintf("%.3f",RMSE)),inherit.aes=FALSE,size=2.5) +
    scale_y_discrete(limits=rev(model_dictionary()$axis_label),drop=FALSE) +
    scale_fill_gradientn(
      colours = c("#00004d", "#4d4d99", "#9999b3", "#ddddf0", "white"),
      # 将五个数据点（最小值、Q1、中位数、Q3、最大值）映射到颜色向量的五个位置
      values = scales::rescale(c(
        min(df_sub$RMSE),
        quantile(df_sub$RMSE, 0.25),
        median(df_sub$RMSE),
        quantile(df_sub$RMSE, 0.75),
        max(df_sub$RMSE)
      )),
      # 自动生成该场景范围内的美观刻度（例如 0.11, 0.12, 0.13, 0.14, 0.15）
      breaks = pretty(rmse_range, n = 4),
      labels = scales::number_format(accuracy = 0.01),
      name = paste("RMSE\n")  # 每个图独立图例标题（可选）
    ) +
    labs(title = scen, x = NULL, y = NULL) +
    theme_minimal(base_size = 11) +
    theme(
      axis.text.x = element_blank(),
      axis.ticks = element_blank(),
      plot.title = element_text(size = 11, hjust = 0.5),
      legend.position = "bottom",
      legend.key.height = unit(0.35, "cm"),
      legend.key.width = unit(0.7, "cm"),
      legend.text = element_text(size = 6),
      legend.title = element_text(size = 7),
      panel.grid = element_blank()
    )
  # Remove y-axis text for Scenario 2 and 3
  if (scen %in% c("Scenario2", "Scenario3", "Scenario4")) {
    p <- p + theme(axis.text.y = element_blank(),
                   legend.title = element_blank()    )
  } else {
    p <- p + theme(axis.text.y = element_text(size = 9))+
      labs(y = "Model")
  }
  return(p)
})

