  pal <- scenario_colours[[scenario_key]]
  if (is.null(pal)) stop("No palette defined for ", scen)
  
  df_all <- df_long %>%
    dplyr::filter(!is.na(model_display), as.character(Scenario) == scen)
  df_null <- df_all[df_all$model_names == "cox_ipw_null", , drop = FALSE]
  df_sub <- df_all[df_all$model_names != "cox_ipw_null", , drop = FALSE]
  
  rmse_range <- range(df_sub$RMSE, na.rm = TRUE)
  if (!all(is.finite(rmse_range)) || diff(rmse_range) <= 0)
    stop("Cannot make RMSE color scale for ", scen, ": check the RMSE values.")
  
  p <- ggplot(df_sub, aes(x = 1, y = model_display, fill = RMSE)) +
    geom_tile(color = "white", width = 0.9) +
    # Null MSM is outside the scenario-specific scale.
    geom_tile(data = df_null, aes(x = 1, y = model_display),
              inherit.aes = FALSE, fill = "#D9D9D9", color = "white",
              width = 0.9) +
    geom_text(data = df_null,
              aes(x = 1, y = model_display, label = sprintf("%.3f", RMSE)),
              inherit.aes = FALSE, size = 2.5, colour = "black") +
    scale_y_discrete(limits = rev(model_dictionary()$axis_label), drop = FALSE) +
    scale_fill_gradient(
      low = unname(pal["low"]), high = unname(pal["high"]),
      limits = rmse_range,
      breaks = rmse_range,
      labels = sprintf("%.3f", rmse_range),
      name = NULL,
      guide = guide_colorbar(barwidth = grid::unit(2.1, "cm"),
                             barheight = grid::unit(0.28, "cm"))
    ) +
    labs(title = scen, x = NULL, y = NULL) +
    theme_minimal(base_size = 11) +
    theme(
      axis.text.x = element_blank(),
      axis.ticks = element_blank(),
      plot.title = element_text(size = 11, hjust = 0.5),
      legend.position = "bottom",
      legend.text = element_text(size = 7),
      panel.grid = element_blank()
    )
  
  if (scenario_key != "Scenario1") {
    p <- p + theme(axis.text.y = element_blank())
  } else {
    p <- p + theme(axis.text.y = element_text(size = 11)) + labs(y = "Model")
  }
  p
})

