# get rmse for bic/aic selected models:
compute_rmse_for_scenario <- function(summary_scenario) {
  
  true_paf <- summary_scenario$summary_tables$PAF_true_mat[1, 1]
  paf_mat <- summary_scenario$summary_tables$PAF_est_mat
  min_bic_model_list <- summary_scenario$summary_tables$min_bic_ipw_model_names
  min_aic_model_list <- summary_scenario$summary_tables$min_aic_ipw_model_names
  
  compute_rmse_from_model_list <- function(model_list, paf_mat, true_paf) {
    selected_paf <- numeric(length(model_list))
    for (i in seq_along(model_list)) {
      model_name <- model_list[i]
      selected_paf[i] <- paf_mat[i, model_name]
    }
    sqrt(mean((selected_paf - true_paf)^2, na.rm = TRUE))
  }
  
  bic_selected_rmse <- compute_rmse_from_model_list(min_bic_model_list, paf_mat, true_paf)
  aic_selected_rmse <- compute_rmse_from_model_list(min_aic_model_list, paf_mat, true_paf)
  
  return(list(
    bic_selected_rmse = bic_selected_rmse,
    aic_selected_rmse = aic_selected_rmse
  ))
}
