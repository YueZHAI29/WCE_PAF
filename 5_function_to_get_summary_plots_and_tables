    .get_count_null <- function(IC_of_interest = "BIC"){
      if(IC_of_interest == "BIC"){
        names_temp <- min_bic_ipw_model_names
      } else if (IC_of_interest == "AIC") {
        names_temp <- min_aic_ipw_model_names
      }
      count_null <- sum(grepl("null", names_temp))
      count_current <- sum(grepl("current", names_temp))
      count_cum <- sum(grepl("cum", names_temp))
      tag_p1 <- if (count_null > 0) paste0("count null: ", count_null, "/ ") else NULL
      tag_p2 <- if (count_current > 0) paste0("count current: ", count_current, "/ ") else NULL
      tag_p3 <- if (count_cum > 0) paste0("count unweighted sum: ", count_cum, "/ ") else NULL
      tag2 <- paste0(tag_p1, tag_p2, tag_p3)
      
      #if (is.null(tag2) || tag2 == "") tag2 <- NULL
      return(tag2)
    }
    
    tag2_aic <- .get_count_null(IC_of_interest ="AIC")
    tag2_bic <- .get_count_null(IC_of_interest ="BIC")
    
    plot_AIC_selected <- .plot_IC_selected_models(est_weight_aic_selected,
                                                  tag = "AIC selected MSMs ", tag2 = tag2_aic)
    plot_BIC_selected <- .plot_IC_selected_models(est_weight_bic_selected,
                                                  tag = "BIC selected MSMs ", tag2 = tag2_bic)
    plot_AIC_selected_wce <- .plot_IC_selected_models(est_weight_aic_selected_wce,
                                                      tag = "AIC selected WCE MSMs ")
    plot_BIC_selected_wce <- .plot_IC_selected_models(est_weight_bic_selected_wce,
                                                      tag = "BIC selected WCE MSMs ")
    
   ###    Save the tables     ###
    directory <- directory
    file_name <- paste0(tag_element_i, "_", tag, "_Tables_HR_", HRA, "_scena_", weight_hypo, "_cutoff_", true_cutoff,
                        "_nsim_", n_sim, "_n_", n)
    output_file <- paste0(directory, file_name, ".txt")
    # Open a connection to the file
    file_conn <- file(output_file, open = "w")
    
    write_nested_tables <- function(x, file_conn, parent_name = NULL) {
      for (name in names(x)) {
        full_name <- if (!is.null(parent_name)) paste(parent_name, name, sep = " -> ") else name
        
        if (is.list(x[[name]]) && !is.data.frame(x[[name]])) {
          # If the element is a nested list (but not a data.frame), recurse
          cat("### Nested list: ", full_name, " ###\n", file = file_conn, append = TRUE)
          write_nested_tables(x[[name]], file_conn, full_name)
        } else {
          # Otherwise, write the table/data.frame
          cat("### ", full_name, " ###\n", file = file_conn, append = TRUE)
          write.table(x[[name]], file = file_conn, sep = "\t", 
                      row.names = TRUE, col.names = TRUE, append = TRUE, quote = FALSE)
          cat("\n\n", file = file_conn, append = TRUE)
        }
      }
    }
    # Clear the file before writing
    cat("", file = file_conn)
    # Call the function on your list
    write_nested_tables(summary_tables, file_conn)
    

    #### for when there are only tables, no list : ###
    # for (table_name in names(summary_tables)) {
    #   # Write a header for the table
    #   cat("### ", table_name, " ###\n", file = file_conn)
    #   # Write the table content
    #   write.table(summary_tables[[table_name]], file = file_conn, sep = "\t", 
    #               row.names = TRUE, col.names = TRUE, append = TRUE, quote = FALSE)
    #   # Add spacing between tables
    #   cat("\n\n", file = file_conn)
    # }
    
    # Close the file connection
    close(file_conn)
    # Check the saved file
    cat("Tables saved to:", output_file)
    
    #### SAVE the plots
    file_name <- paste0(tag_element_i, "_", tag, "_Plots_HR_", HRA, "_scena_", weight_hypo, "_cutoff_", true_cutoff,
                        "_nsim_", n_sim, "_n_", n)
 
    pdf(file = paste0(directory, file_name, "_plots.pdf"), height = 7, width = 11)
    # Combine all plots into one list
    all_plots <- list(
      plot_P0_bias,
      plot_PAF_bias,
      plot_P0_bias_unadj,
      plot_PAF_bias_unadj,
      plot_AIC_selected,
      plot_BIC_selected,
      plot_AIC_selected_wce,
      plot_BIC_selected_wce
    )
    # Add plots from plot_list
    all_plots <- c(all_plots, plot_list)
    # Plot 4 per page
    par(mfrow = c(2, 2))  # 2 rows, 2 columns
    for (i in seq_along(all_plots)) {
      print(all_plots[[i]])
            # After every 4 plots, reset layout (to trigger new page)
      if (i %% 4 == 0 && i != length(all_plots)) {
        par(mfrow = c(2, 2))  # Start a new page
      }
    }
    dev.off()
    ##### to arrange four plots per page: ####
    # for (i in seq(1, length(all_plots), by = 4)) {
    #   # Select up to 4 plots
    #   plots_to_print <- all_plots[i:min(i+3, length(all_plots))]
    #   # Arrange them 2x2 on one page
    #   grid.arrange(grobs = plots_to_print, nrow = 2, ncol = 2)
    # }
  return(list(summary_tables = summary_tables,
              analysis_setting = list(HR=HRA,N=n,scenario=weight_hypo), # [REV-RUN]
              all_plots = all_plots,
              plots_by_model = plots_by_model, # [REV-DISPLAY]
              cum_effect_coefficients = cum_effect_coefficients, # [REV-MCSE]
              plot_P0_bias = plot_P0_bias, 
              plot_PAF_bias = plot_PAF_bias,
              plot_AIC_selected = plot_AIC_selected,
              plot_BIC_selected = plot_BIC_selected))
}



