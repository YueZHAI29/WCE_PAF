# [REV-MCSE] Integrated MCSE functions (no external script 8 required).
# MCSEs are conditional on the supplied reference truth.
# Variance/empirical-SE/RMS-SE/RMSE MCSEs use first-order delta methods,
# with empirical moments (no normality assumption for the PAF estimates).

mcse_metrics <- function(x, truth) {
  if (length(truth) != 1L || !is.finite(truth))
    stop('Supply one fixed finite reference truth per setting.')
  if (length(x) < 3L || any(!is.finite(x)))
    stop('Need >=3 finite replicate estimates; handle/report failures explicitly.')
  n <- length(x); e <- x-truth; s <- sd(x); v <- var(x)
  mse <- mean(e^2); rmse <- sqrt(mse)
  # Influence contributions for the sample variance (finite-n correction).
  iv <- n/(n-1) * ((x-mean(x))^2 - mean((x-mean(x))^2))
  v_mcse <- sd(iv)/sqrt(n)
  estimates <- c(mean=mean(x), bias=mean(e), relative_bias_pct=if(truth!=0) 100*mean(e)/truth else NA_real_,
                 variance=v, empirical_SE=s, RMSE=rmse)
  errors <- c(s/sqrt(n), s/sqrt(n), if(truth!=0) 100*s/(abs(truth)*sqrt(n)) else NA_real_,
              v_mcse, if(s>0) v_mcse/(2*s) else 0,
              if(rmse>0) sd(e^2)/(2*rmse*sqrt(n)) else 0)
  data.frame(metric=names(estimates), estimate=unname(estimates), MCSE=errors, R=n,
             row.names=NULL)
}

mcse_proportion <- function(indicator) {
  if(anyNA(indicator) || !all(indicator %in% c(0,1))) stop('Need complete binary indicators.')
  p <- mean(indicator); n <- length(indicator)
  # Boundary plug-in MCSE=0 does not mean zero uncertainty.
  data.frame(estimate=100*p, MCSE=100*sqrt(p*(1-p)/n), R=n,
             boundary=p %in% c(0,1))
}

model_dictionary <- function(n_visit = 100L) {
  d <- data.frame(model_id = c('cox_ipw_null', 'cox_ipw_current',
    'cox_ipw_cum_half', 'cox_ipw_cum_whole'),
    label = c('Null MSM', 'Current exposure',
      paste0('Unweighted cumulative exposure, ', n_visit/2, ' visits'),
      paste0('Unweighted cumulative exposure, ', n_visit, ' visits')))
  for (window in c('half', 'whole')) for (constraint in c('', '_left', '_right')) {
    visits <- if (window == 'half') n_visit/2 else n_visit
    term <- if (constraint == '') 'unconstrained' else if (constraint == '_left')
      'left-constrained' else 'right-constrained'
    for (k in 1:3) d <- rbind(d, data.frame(
      model_id = paste0('cox_ipw_wce_', k, 'knots_', window, constraint),
      label = paste0('WCE, ', visits, ' visits, ', term, ', ', k,
                     if (k == 1) ' knot' else ' knots')))
  }
  d <- rbind(d, data.frame(model_id = c('AIC_selected_model', 'BIC_selected_model'),
    label = c('AIC-selected model', 'BIC-selected model')))
  # Single-line model labels
  d$axis_label <- d$label
  
  d$order_top_to_bottom <- seq_len(nrow(d))
  d
}

wce_order_ids <- function(ids, n_visit=100) {
  official <- model_dictionary(n_visit)$model_id
  c(intersect(official,ids),setdiff(ids,official))
}
wce_display_factor <- function(ids, include_ids=NULL, n_visit=100) {
  if(is.null(include_ids)) include_ids <- unique(as.character(ids))
  ordered <- rev(wce_order_ids(include_ids,n_visit))
  dict <- model_dictionary(n_visit)
  labels <- dict$axis_label[match(ordered,dict$model_id)]
  labels[is.na(labels)] <- ordered[is.na(labels)]
  factor(as.character(ids),levels=ordered,labels=labels)
}
wce_add_display <- function(d) {
  d$model_display <- wce_display_factor(d$model_names)
  d
}
wce_rmse_data <- function(summaries) {
  rows <- lapply(seq_along(summaries),function(i) {
    z <- summaries[[i]]$summary_tables
    a <- mcse_main_tables(z,paste0('Scenario',i),NA,NA)$performance
    a <- a[a$metric=='RMSE',]
    a$model <- sub('^(AIC|BIC)-selected$','\\1_selected_model',a$model)
    a <- a[a$model %in% model_dictionary()$model_id,,drop=FALSE]
    data.frame(model_names=a$model,Scenario=paste0('Scenario',i),RMSE=a$estimate,
               RMSE_MCSE=a$MCSE,R=a$R)
  })
  do.call(rbind,rows)
}
wce_frequency_data <- function(summaries) {
  rows <- lapply(seq_along(summaries),function(i) {
    a <- mcse_main_tables(summaries[[i]],paste0('Scenario',i),NA,NA)$selection
    data.frame(model_names=a$model,scenario=paste('Scenario',i),metric=a$criterion,
               scenario_metric=paste0('Scenario ',i,'_',a$criterion),frequency=a$estimate,
               MCSE=a$MCSE,R=a$R,count=round(a$estimate*a$R/100))
  })
  d <- do.call(rbind,rows)
  d$metric <- factor(d$metric,levels=c('AIC','BIC'))
  d
}
wce_export_MCSE <- function(summaries,HRA,size,output_dir) {
  dir.create(output_dir,recursive=TRUE,showWarnings=FALSE)
  ans <- lapply(seq_along(summaries),function(i)
    mcse_main_tables(summaries[[i]],paste0('Scenario',i),size,HRA))
  for(k in c('performance','selection')) {
    d <- do.call(rbind,lapply(ans,`[[`,k))
    d$model_id <- sub('^(AIC|BIC)-selected$','\\1_selected_model',d$model)
    dict <- model_dictionary(); d$model_display <- dict$label[match(d$model_id,dict$model_id)]
    d <- d[order(d$scenario,match(d$model_id,dict$model_id)),]
    if(k=='selection') d$count <- round(d$estimate*d$R/100)
    d$estimate_MCSE <- sprintf('%.5f (%.5f)',d$estimate,d$MCSE)
    write.csv(d,file.path(output_dir,paste0(k,'_MCSE_HR',HRA,'_n',size,'.csv')),row.names=FALSE)
  }
  write.csv(model_dictionary(),file.path(output_dir,'model_display_dictionary.csv'),row.names=FALSE)
  rr <- wce_rmse_data(summaries)
  write.csv(rr[rr$model_names=='cox_ipw_null',],
            file.path(output_dir,paste0('null_RMSE_MCSE_HR',HRA,'_n',size,'.csv')),row.names=FALSE)
  invisible(ans)
}

# Refresh existing summary plots without changing their geom/theme definitions.
wce_refresh_summary <- function(z) {
  tab <- z$summary_tables; x <- as.matrix(tab$PAF_est_mat)
  for(ic in c("AIC","BIC")) {
    ids <- as.character(tab[[paste0("min_",tolower(ic),"_ipw_model_names")]])
    x <- cbind(x,x[cbind(seq_len(nrow(x)),match(ids,colnames(x)))])
    colnames(x)[ncol(x)] <- paste0(ic,"_selected_model")
  }
  for(what in c("PAF","P0")) {
    key <- paste0("plot_",what,"_bias")
    if(is.null(z[[key]])) next
    if(what=="PAF") errors <- x - tab$PAF_true_mat[1,1] else {
      errors <- as.matrix(tab$P0_mat)
      truth <- tab$estimands_mat[1,"Pr_Y_A0 mean"]-tab$estimands_mat[1,"Pr_Y_A0 bias"]
      errors <- errors-truth
      for(ic in c("AIC","BIC")) {
        ids <- as.character(tab[[paste0("min_",tolower(ic),"_ipw_model_names")]])
        errors <- cbind(errors,errors[cbind(seq_len(nrow(errors)),match(ids,colnames(errors)))])
        colnames(errors)[ncol(errors)] <- paste0(ic,"_selected_model")
      }
    }
    ids <- intersect(model_dictionary()$model_id,colnames(errors))
    d <- data.frame(model=rep(ids,each=nrow(errors)),value=as.vector(errors[,ids,drop=FALSE]))
    names(d)[2] <- paste0(what,"_bias")
    d$model <- wce_display_factor(d$model,include_ids=ids)
    z[[key]]$data <- d
    # [REV-NO-BLUE-DOTS] Also remove jitter layers when reusing an OLD summary plot.
    # StatSummary red mean points and boxplot outliers are retained.
    keep_layers <- vapply(z[[key]]$layers,function(layer)
      !(inherits(layer$geom,"GeomPoint") && inherits(layer$position,"PositionJitter")),logical(1))
    z[[key]]$layers <- z[[key]]$layers[keep_layers]
  }
  if(is.null(z$plots_by_model)) {
    ids <- grep("wce",colnames(tab$PAF_est_mat),value=TRUE)
    z$plots_by_model <- setNames(lapply(seq_along(ids),function(i)
       z$all_plots[[paste0("plot_",i)]]),ids)
  }
  z
}

